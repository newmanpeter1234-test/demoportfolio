generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String
  description String
  category    String
  year        String
  tags        String // comma separated
  imageUrl    String
  accent      String // hex accent color of the card
  link        String?
  likes       Int      @default(0)
  views       Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("Hello")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteStat {
  key       String   @id
  value     Int      @default(0)
}
